# Copy to .env for local development. On Railway use the Variables tab instead.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Optional — leave unset to use the defaults shown.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=medium            # low | medium | high
# DACUM_MAX_TOKENS=8000
# MODULE_MAPPING_MAX_TOKENS=16000
# UPSTREAM_TIMEOUT_MS=150000
# RATE_LIMIT_MAX=60                  # per IP per minute; 0 = off
# ALLOWED_ORIGINS=https://hshamjawad.github.io
# DEBUG_ERRORS=1                     # include Anthropic's error text in replies (debugging only)
